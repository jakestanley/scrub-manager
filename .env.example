# Directory scanned (recursively) for videos
VIDEO_DIR=/var/videos

# Where scrub previews are written; mirrors VIDEO_DIR's folder structure. Put this on fast storage.
SCRUB_DIR=~/.local/share/trickplay/scrubs

# Where the SQLite database (videos, status, tags) lives
DATA_DIR=./data

# Concurrent preview generators
MAX_WORKERS=1

# Seconds between background scans of VIDEO_DIR
SCAN_INTERVAL=900

# Failed previews are retried with increasing delays, up to this many attempts
MAX_ATTEMPTS=5

# Jellyfin's trickplay "Interval" setting, in seconds (Jellyfin default: 10)
JELLYFIN_TRICKPLAY_INTERVAL=10

PORT=5003
DEBUG=false
